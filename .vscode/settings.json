{
    // Don't let CMake Tools auto-configure or nag on folder open;
    // the makefile drives the build.
    "cmake.configureOnOpen": false,

    // Hide the C/C++ extension's "build and debug active file" button and
    // its auto-detected per-compiler tasks from the debug picker.
    "C_Cpp.debugShortcut": false,

    // clangd is the language server (user settings already disable cpptools
    // IntelliSense). --clang-tidy reports .clang-tidy findings in Problems as
    // you type; --compile-commands-dir points it at out/compile_commands.json
    // so it sees the real build flags.
    "clangd.path": "/usr/bin/clangd-22",
    "clangd.arguments": [
        "--clang-tidy",
        "--compile-commands-dir=${workspaceFolder}/out"
    ]
}
